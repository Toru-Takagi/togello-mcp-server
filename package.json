{
  "type": "module",
  "name": "togello-mcp-server",
  "version": "1.0.41",
  "description": "MCP server for Togello tasks, calendar memos, calendar events, and activity logs.",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
